# Copy file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
# Giá trị mặc định dưới đây trùng với application-dev.yml để chạy từ IDE không cần cấu hình thêm.

POSTGRES_DB=ticketbox
POSTGRES_USER=ticketbox
POSTGRES_PASSWORD=ticketbox_dev
DB_PORT=5433

REDIS_PASSWORD=redis_dev
REDIS_PORT=6379

# Khóa ký JWT, tối thiểu 32 ký tự. Sinh ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=dev-only-secret-khong-dung-cho-production-0123456789

# Tài khoản admin tạo sẵn khi khởi động (profile dev)
ADMIN_EMAIL=admin@ticketbox.local
ADMIN_PASSWORD=Admin@123456
