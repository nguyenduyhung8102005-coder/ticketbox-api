# Copy file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
# Giá trị mặc định dưới đây trùng với application-dev.yml để chạy từ IDE không cần cấu hình thêm.

POSTGRES_DB=ticketbox
POSTGRES_USER=ticketbox
POSTGRES_PASSWORD=ticketbox_dev
DB_PORT=5433

REDIS_PASSWORD=redis_dev
REDIS_PORT=6379

# Khóa ký JWT, tối thiểu 32 ký tự. Sinh ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=dev-only-secret-khong-dung-cho-production-0123456789

# Tài khoản admin tạo sẵn khi khởi động (profile dev)
ADMIN_EMAIL=admin@ticketbox.local
ADMIN_PASSWORD=Admin@123456

# ----- Giai đoạn 3 -----
# Kafka (docker compose). Chạy app trong Docker thì dùng kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Mailpit: SMTP giả nhận mọi email, xem hộp thư tại http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

# Khóa ký mã vé (QR), tối thiểu 32 ký tự. Đổi khóa thì vé cũ không xác minh được nữa.
TICKET_SIGNING_SECRET=dev-only-ticket-secret-khong-dung-cho-production

# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận qua email
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
# Trang trình duyệt quay về sau thanh toán (thường là trang của frontend)
VNPAY_RETURN_URL=http://localhost:8081/api/v1/payments/vnpay/return
